{"legislative_session": "2026A", "identifier": "HB 1245", "title": "Theft by Contractor", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Crimes, Corrections, & Enforcement"], "abstracts": [{"note": "summary", "abstract": "The bill specifies that a person commits theft when the person knowingly uses an advance payment for a construction project for an unrelated purpose that results in the delay, end, abandonment, or material nonperformance of the construction project.The bill requires that before a contractor can take an advance payment from a customer, a contractor shall provide the customer with a written disclosure identifying the intended use of the advance payment, the anticipated timing of expenses identified in the disclosure, and the project's anticipated start date.(Note: This summary applies to this bill as introduced.)"}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-co-2026a-hb1245"}], "actions": [{"description": "House Third Reading Lost - No Amendments", "date": "2026-04-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "House Third Reading Laid Over Daily - No Amendments", "date": "2026-04-20", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "House Second Reading Special Order - Passed with Amendments - Floor", "date": "2026-04-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "House Second Reading Special Order - Laid Over Daily - No Amendments", "date": "2026-04-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "House Second Reading Laid Over Daily - No Amendments", "date": "2026-03-06", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"descr
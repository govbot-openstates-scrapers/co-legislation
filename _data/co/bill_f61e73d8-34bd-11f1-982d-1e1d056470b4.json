{"legislative_session": "2026A", "identifier": "HB 1095", "title": "Digital Publication for Legal Notice", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Local Government", "State Government"], "abstracts": [{"note": "summary", "abstract": "Current law requires a county or municipality to publish legal notices in a physical print newspaper. The bill gives a county or municipality discretion to publish legal notices online on the newspaper's website instead. Legal notices published online must be free to access and cannot be kept behind a paywall or subscription.(Note: This summary applies to this bill as introduced.)"}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-co-2026a-hb1095"}], "actions": [{"description": "Introduced In House - Assigned to Transportation, Housing & Local Government", "date": "2026-02-03", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": [{"name": "Transportation, Housing & Local Government", "entity_type": "organization", "organization_id": null}, {"name": "Transportation", "entity_type": "organization", "organization_id": null}, {"name": "Local Government", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "L. Suckla", "classification": "sponsor", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \" L. Suckla\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "Introduced", "links": [{"url": "https://leg.colorado.gov/bill_files/111198/download", "media_type": "application/pdf"}], "date": "2026-02-03", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://leg.colorado.gov/bills/HB26-1095", "note": ""}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:co/government", "name": "Colorado", "classification": "state", "division_id": "ocd-division/country:us/sta